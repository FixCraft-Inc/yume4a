<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 and older read this file. The manifest sets allowBackup to
   false, and these rules exclude everything as well, so a build that turned
   backups on by mistake would still take no key.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
