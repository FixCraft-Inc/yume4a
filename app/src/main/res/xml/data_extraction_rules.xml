<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Actual secret blobs (auth keys, CA material, vault data, secure material files)
   are stored in noBackupFilesDir, so Android already excludes them. These rules
   cover the three SharedPreferences files that contain sensitive metadata and
   legacy migration data that should not land in cloud backup.

   yume_app_settings is intentionally kept — it holds only UI preferences
   (theme, language, connection technique) with no credentials.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="yume_app_vault_boot"/>
        <exclude domain="sharedpref" path="yume_secure_materials"/>
        <exclude domain="sharedpref" path="yume_vpn_profiles"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="yume_app_vault_boot"/>
        <exclude domain="sharedpref" path="yume_secure_materials"/>
        <exclude domain="sharedpref" path="yume_vpn_profiles"/>
    </device-transfer>
</data-extraction-rules>